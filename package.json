{
  "name": "point-cloud-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun --filter point-cloud dev",
    "build": "bun run --workspaces --if-present build",
    "start": "bun --filter point-cloud start",
    "storybook": "bun --filter @atelier/ui storybook",
    "build-storybook": "bun --filter @atelier/ui build-storybook",
    "typecheck": "bun run --workspaces --if-present typecheck",
    "lint": "bun run --workspaces --if-present lint",
    "test": "bun x vitest run",
    "test:watch": "bun x vitest",
    "format": "bun x prettier --write .",
    "format:check": "bun x prettier --check ."
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "jsdom": "^27.0.0",
    "prettier": "^3.9.8",
    "typescript": "~6.0.3",
    "vitest": "^5.0.1"
  },
  "engines": {
    "node": ">=22"
  }
}
